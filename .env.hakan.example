# HUNTER — "hakan" profile (marketing, cover-letter-only).
#
# This is the committed TEMPLATE for a second bot that runs from the SAME checkout
# as the default (PM) bot. Copy it to `.env.hakan` (gitignored) and fill the
# SECRETS, then run:
#
#   HUNTER_PROFILE=hakan .venv/bin/python main.py bot
#
# `HUNTER_PROFILE=hakan` makes config/settings.py load `.env.hakan` ON TOP of `.env`
# (overlay wins). Only the keys that differ from the defaults need to be set here;
# everything else falls back to config/settings.py.
#
# Layout mirrors .env.example: SECRETS (credentials + PII, never commit the filled
# `.env.hakan`) then CONFIG (non-secret marketing tuning).

# =============================================================================
# SECRETS — fill these in `.env.hakan` (do NOT commit the filled file).
# =============================================================================

# A SEPARATE Telegram bot (new @BotFather bot) and Hakan's own chat id.
TELEGRAM_BOT_TOKEN=hakans_bot_token_here
TELEGRAM_CHAT_ID=hakans_chat_id_here

# Anthropic key for cover-letter generation (can reuse the same key).
ANTHROPIC_API_KEY=your_anthropic_key_here

# Hakan's resume. Preferred: drop the CV text in config/resume.hakan.txt (gitignored),
# which takes precedence for this profile. Otherwise set it here.
RESUME_TEXT=

# Hakan's PII (used to label cover letters / answers; no forms are submitted).
APPLICANT_NAME=Ahmet Hakan Sekmen
APPLICANT_FIRST_NAME=Hakan
APPLICANT_LAST_NAME=Sekmen
APPLICANT_EMAIL=hakans_email_here
APPLICANT_PHONE=hakans_phone_here
APPLICANT_LINKEDIN=https://www.linkedin.com/in/hakansekmen
APPLICANT_WEBSITE=

# =============================================================================
# CONFIG — marketing tuning (non-secret; safe to keep in this template).
# =============================================================================

# Separate database so the two bots never share state.
DB_PATH=hunter_hakan.db
# Stagger off the default bot's 9:00 hunt when co-located on one machine.
HUNT_SCHEDULE_HOUR=10
FOLLOWUP_SCHEDULE_HOUR=11

# No auto-apply: the review UI drops Approve and /apply refuses. Hakan applies
# manually via the job link.
ENABLE_AUTO_APPLY=false
# Cover-letter generation off for now (pure job feed: Skip / View Job). Flip to
# true to add a 📄 Cover Letter button per job.
ENABLE_COVER_LETTERS=false
# API-only sources (no Chromium) — lighter, and Hakan never needs the apply browser.
ENABLE_BROWSER_SCRAPERS=false

# Include on-site Istanbul roles as well as remote (Hakan is Istanbul-based).
REMOTE_REQUIRED=false

# --- Marketing targeting ---
# Free-text queries used by query-driven sources (RemoteOK uses tags below instead).
SEARCH_QUERIES=Performance Marketing Manager,Growth Marketing Manager,Digital Marketing Manager,Paid Social Manager,Marketing Manager,Head of Growth,PPC Manager,Demand Generation Manager
# Catalog sources (Greenhouse/Lever/Ashby list every role) keep only titles containing
# one of these — retargets the same boards from PM to marketing.
ROLE_MATCH_KEYWORDS=marketing manager,growth marketing,performance marketing,digital marketing,paid social,paid media,head of marketing,head of growth,marketing lead,growth lead,ppc,demand generation,cro,marketing director,brand manager,social media manager
# Still drop junior/intern-level roles (Hakan is senior).
ROLE_EXCLUDE_KEYWORDS=junior,jr,intern,apprentice,working student,graduate,entry level,entry-level,trainee,co-op,student
# RemoteOK is tag-driven (api?tag=<tag>); marketing tags instead of product.
REMOTEOK_TAGS=marketing,digital-marketing,growth
# We Work Remotely marketing RSS feed (instead of the product feed).
WEWORKREMOTELY_FEEDS=https://weworkremotely.com/categories/remote-marketing-jobs.rss

# --- Region / sponsor filtering ---
# Reuse the defaults (Istanbul reads as EMEA). REGION_ALLOWLIST=us,eu,emea and
# CANDIDATE_WORK_REGIONS=emea,eu come from config/settings.py — no override needed.

# --- Pre-built answers (marketing) ---
ANSWER_YOE=6+
ANSWER_WORK_AUTH=Based in Istanbul, Turkey, authorized to work in EMEA. Open to relocation and remote roles in EU/EMEA timezones.
ANSWER_REMOTE=Yes, I work effectively with remote and distributed teams and have delivered global campaigns across multiple markets.
ANSWER_REQUIRES_SPONSORSHIP=yes
ANSWER_WORK_AUTHORIZED=no
ANSWER_LOCATION=Istanbul, Turkey
ANSWER_DEMOGRAPHIC=Decline to self-identify
ANSWER_REFERRAL=LinkedIn

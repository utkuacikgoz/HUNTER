# HUNTER — "hakan" profile (marketing, sourcing-only, remote OR freelance).
#
# This is the committed TEMPLATE for a second bot that runs from the SAME checkout
# as the default (PM) bot. Copy it to `.env.hakan` (gitignored) and fill the
# SECRETS, then run:
#
#   HUNTER_PROFILE=hakan .venv/bin/python main.py bot
#
# `HUNTER_PROFILE=hakan` makes config/settings.py load `.env.hakan` ON TOP of `.env`
# (overlay wins). Only the keys that differ from the defaults need to be set here;
# everything else falls back to config/settings.py.
#
# Layout mirrors .env.example: SECRETS (credentials + PII, never commit the filled
# `.env.hakan`) then CONFIG (non-secret marketing tuning).

# =============================================================================
# SECRETS — fill these in `.env.hakan` (do NOT commit the filled file).
# =============================================================================

# A SEPARATE Telegram bot (new @BotFather bot) and Hakan's own chat id.
TELEGRAM_BOT_TOKEN=hakans_bot_token_here
TELEGRAM_CHAT_ID=hakans_chat_id_here

# Anthropic key for cover-letter generation (can reuse the same key).
ANTHROPIC_API_KEY=your_anthropic_key_here

# Hakan's resume. Preferred: drop the CV text in config/resume.hakan.txt (gitignored),
# which takes precedence for this profile. Otherwise set it here.
RESUME_TEXT=

# Hakan's PII (used to label cover letters / answers; no forms are submitted).
APPLICANT_NAME=Ahmet Hakan Sekmen
APPLICANT_FIRST_NAME=Hakan
APPLICANT_LAST_NAME=Sekmen
APPLICANT_EMAIL=hakans_email_here
APPLICANT_PHONE=hakans_phone_here
APPLICANT_LINKEDIN=https://www.linkedin.com/in/hakansekmen
APPLICANT_WEBSITE=

# =============================================================================
# CONFIG — marketing tuning (non-secret; safe to keep in this template).
# =============================================================================

# Separate database so the two bots never share state.
DB_PATH=hunter_hakan.db
# Stagger off the default bot's 9:00 hunt when co-located on one machine.
HUNT_SCHEDULE_HOUR=10
FOLLOWUP_SCHEDULE_HOUR=11

# No auto-apply: the review UI drops Approve and /apply refuses. Hakan applies
# manually via the job link.
ENABLE_AUTO_APPLY=false
# Cover-letter generation off for now (pure job feed: Skip / View Job). Flip to
# true to add a 📄 Cover Letter button per job.
ENABLE_COVER_LETTERS=false
# API-only sources (no Chromium) — lighter, and Hakan never needs the apply browser.
ENABLE_BROWSER_SCRAPERS=false

# Remote OR freelance only. These two work as a pair: REMOTE_REQUIRED alone would drop
# the on-site Istanbul contract gigs Hakan wants, and leaving it off (as this profile
# used to) let on-site PERMANENT roles in. Together they read as "remote OR freelance" —
# a role must be remote, or read as freelance/contract/interim. Detection is text-only
# and title-first (see detect_freelance in scraper/filters.py); it deliberately ignores
# part-time/hourly, which describe a schedule rather than a contract type.
REMOTE_REQUIRED=true
ALLOW_ONSITE_FREELANCE=true

# --- Marketing targeting ---
# Free-text queries for query-driven sources. NOTE: every source this profile currently
# runs is a catalog source (accepts_query=False) that ignores these — the query-driven
# ones (Wellfound, LinkedIn) are both off. Kept accurate for when that changes; the knob
# that actually shapes this feed is ROLE_MATCH_KEYWORDS below.
SEARCH_QUERIES=Performance Marketing Manager,Growth Marketing Manager,Digital Marketing Manager,Paid Social Manager,Marketing Manager,Head of Growth,PPC Manager,Demand Generation Manager,Freelance Marketing Consultant,Contract Marketing Manager,Interim Head of Marketing,Fractional CMO,Marketing Consultant
# Catalog sources (Greenhouse/Lever/Ashby list every role) keep only titles containing
# one of these — retargets the same boards from PM to marketing. This gate runs BEFORE
# the freelance filter, so freelance-shaped titles ("Freelance Marketing Consultant",
# "Fractional CMO") need keywords here or they never reach it at all.
# Matched as plain substrings, so keep them specific: bare "consultant" would pull in
# every Salesforce/SAP Consultant, and bare "cro" used to admit "Microservices Engineer"
# and "Microsoft Ads Specialist" — hence "cro manager,conversion rate".
ROLE_MATCH_KEYWORDS=marketing manager,growth marketing,performance marketing,digital marketing,paid social,paid media,head of marketing,head of growth,marketing lead,growth lead,ppc,demand generation,cro manager,conversion rate,marketing director,brand manager,social media manager,marketing consultant,growth consultant,seo consultant,brand consultant,marketing strategist,growth marketer,cmo,chief marketing officer,freelance marketer,marketing freelancer
# Still drop junior/intern-level roles (Hakan is senior).
ROLE_EXCLUDE_KEYWORDS=junior,jr,intern,apprentice,working student,graduate,entry level,entry-level,trainee,co-op,student
# RemoteOK is tag-driven (api?tag=<tag>); marketing tags instead of product. contract /
# freelance are cross-function tag pages — ROLE_MATCH_KEYWORDS trims them back to
# marketing titles, the same broad-tag-plus-title-filter pattern config/settings.py uses
# for the "product" tag. RemoteOK is remote-only, so this is about surfacing more
# contract work, not about reach: everything it returns already clears the remote gate.
REMOTEOK_TAGS=marketing,digital-marketing,growth,contract,freelance
# We Work Remotely marketing RSS feed (instead of the product feed). WWR categories are
# job-function-based and the feed is remote-only, so there's no contract feed to add.
WEWORKREMOTELY_FEEDS=https://weworkremotely.com/categories/remote-marketing-jobs.rss

# --- Region / sponsor filtering ---
# Drop "us" from the allowlist (default is us,eu,emea). Load-bearing: ALLOW_ONSITE_FREELANCE
# above reopens the on-site door, and the country-lock check only inspects REMOTE roles —
# so this line is the only thing stopping a US on-site freelance gig, which is no use to an
# Istanbul-based candidate who needs sponsorship. US *remote* is handled separately by the
# country-lock check. Keeps EU/EMEA (incl. Istanbul) remote + freelance.
REGION_ALLOWLIST=eu,emea
# CANDIDATE_WORK_REGIONS=emea,eu comes from config/settings.py — no override needed.

# --- Pre-built answers (marketing) ---
ANSWER_YOE=6+
ANSWER_WORK_AUTH=Based in Istanbul, Turkey, authorized to work in EMEA. Open to relocation and remote roles in EU/EMEA timezones.
ANSWER_REMOTE=Yes, I work effectively with remote and distributed teams and have delivered global campaigns across multiple markets.
ANSWER_REQUIRES_SPONSORSHIP=yes
ANSWER_WORK_AUTHORIZED=no
ANSWER_LOCATION=Istanbul, Turkey
ANSWER_DEMOGRAPHIC=Decline to self-identify
ANSWER_REFERRAL=LinkedIn

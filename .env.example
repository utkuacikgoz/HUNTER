# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# LinkedIn (session cookie - grab from browser dev tools)
LINKEDIN_SESSION_COOKIE=your_li_at_cookie_here

# Indeed
INDEED_API_KEY=optional

# Anthropic Claude (for cover letter generation)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Job Preferences
TARGET_ROLE=Senior Product Manager
MIN_SALARY=80000
LOCATIONS=EMEA,Remote,US
MAX_JOBS_PER_DAY=50
# How many of the search queries to run per scrape (0 = all).
MAX_QUERIES_PER_RUN=0

# --- Region / sponsor filtering ---
# Only show jobs marked Remote AND located in one of these regions (us, eu, emea).
REGION_ALLOWLIST=us,eu,emea
# Require remote roles. Set false to also surface on-site.
REMOTE_REQUIRED=true
# Companies known to hire international / sponsor visas. Case-insensitive, comma-separated.
SPONSOR_FRIENDLY_COMPANIES=Stripe,GitLab,Automattic,Spotify,Klarna,Wise,Remote,Deel,Toptal,Doist,Buffer,Zapier,Hotjar,Canonical,Elastic,HashiCorp,Sourcegraph,Vercel,Supabase,Linear,Notion,Figma,Atlassian,Mozilla,Shopify,Discord,Cloudflare,DigitalOcean,n8n,Mattermost,GitHub,MongoDB,Auth0,Postman,Snyk,Datadog,Miro,Loom,1Password,ClickUp
# Companies you never want to see again (start empty, populate as you go).
SPONSOR_BLOCKLIST_COMPANIES=
# When true, call Claude on jobs whose company is unknown to decide visa-sponsor signal.
ENABLE_LLM_SPONSOR_SCORING=false

# --- Hiring velocity (DB-only signal) ---
VELOCITY_WINDOW_DAYS=14
VELOCITY_HOT_THRESHOLD=3
VELOCITY_BOOST_RANK=true

# --- Scraper health ---
# Comma-separated Playwright selectors tried in order for Wellfound.
WELLFOUND_SELECTORS=div.styles_jobListing__aFBtk,div[class*='jobListing'],div.mb-6
# Skip a scraper when its last N runs all returned 0 jobs (0 = never skip).
SCRAPER_SKIP_AFTER_ZEROS=3

# Resume
RESUME_PATH=config/resume.pdf

# Applicant PII (used for form filling)
APPLICANT_NAME=Your Full Name
APPLICANT_FIRST_NAME=Your
APPLICANT_LAST_NAME=Name
APPLICANT_EMAIL=you@example.com
APPLICANT_PHONE=+1 555 000 0000
APPLICANT_LINKEDIN=https://www.linkedin.com/in/yourprofile
APPLICANT_WEBSITE=https://yoursite.com

# Pre-built form answers
ANSWER_SALARY=$80,000 - $120,000 depending on total compensation package
ANSWER_AVAILABILITY=Available to start within 2-4 weeks
ANSWER_WORK_AUTH=Based in Turkey, authorized to work in EMEA. Open to relocation and can work US timezone hours.
ANSWER_REMOTE=Yes, I have extensive experience working remotely with distributed teams across Turkey, UAE, KSA, and the US.
ANSWER_YOE=8+

# HUNTER configuration.
#
# Local dev: copy this file to `.env` and fill in everything you need.
# Production (fly.io): the two groups below map to two different places —
#   • SECRETS  → `fly secrets set KEY=value ...`  (encrypted, never in git)
#   • CONFIG   → `[env]` in fly.toml              (committed) or rely on
#                the defaults baked into config/settings.py.
# Defaults live in config/settings.py; only set a CONFIG var to override one.

# =============================================================================
# SECRETS — credentials + PII.  In production set these with `fly secrets set`,
# NOT in fly.toml.  Keep them out of version control.
# =============================================================================

# Telegram — token from @BotFather; chat id gates who can drive the bot.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Anthropic Claude (cover letters / form answers / sponsor scoring).
ANTHROPIC_API_KEY=your_anthropic_key_here

# LinkedIn session cookie (optional; LinkedIn scraping is disabled by default).
LINKEDIN_SESSION_COOKIE=your_li_at_cookie_here

# Resume as plain text. Preferred over a file in prod (no PII baked into the
# image): `fly secrets set RESUME_TEXT="$(cat config/resume.txt)"`.
# Locally you can instead drop config/resume.txt and leave this empty.
RESUME_TEXT=

# Applicant PII — used to auto-fill application forms.
APPLICANT_NAME=Your Full Name
APPLICANT_FIRST_NAME=Your
APPLICANT_LAST_NAME=Name
APPLICANT_EMAIL=you@example.com
APPLICANT_PHONE=+1 555 000 0000
APPLICANT_LINKEDIN=https://www.linkedin.com/in/yourprofile
APPLICANT_WEBSITE=https://yoursite.com

# =============================================================================
# CONFIG — non-secret tuning.  In production set in fly.toml [env] (or leave
# unset to use the config/settings.py defaults shown here).
# =============================================================================

# Claude model for form answers (submitted in applications — keep quality up).
CLAUDE_MODEL=claude-sonnet-5
# Cheap model for the high-frequency yes/no/unclear sponsor classifier.
SPONSOR_MODEL=claude-haiku-4-5
# Stronger model just for cover letters (low volume, represents you to employers).
COVER_LETTER_MODEL=claude-opus-5

# Logging.
LOG_LEVEL=INFO

# SQLite path. In prod this points at the mounted fly volume (set in fly.toml).
# DB_PATH=/data/hunter.db

# Resume file path (used only when RESUME_TEXT is empty).
RESUME_PATH=config/resume.pdf

# Master switch for the auto-apply path. false → the review UI drops Approve and
# /apply refuses (sourcing-only; applies manually).
ENABLE_AUTO_APPLY=true
# Offer the 📄 Cover Letter button in the review UI when auto-apply is off. false →
# pure job feed (Skip / View Job). No effect while ENABLE_AUTO_APPLY is true.
ENABLE_COVER_LETTERS=true
# Run the browser scrapers (RemoteOK, Wellfound — they launch Chromium). false →
# API-only sources, lighter on RAM.
ENABLE_BROWSER_SCRAPERS=true
# Apply engine: when true, structured ATS appliers (Greenhouse/Lever) fill the
# form but DO NOT click submit (screenshot only). Verify the screenshots, then set
# false to actually submit. Each job is still human-approved in Telegram first.
APPLY_DRY_RUN=false
# Max jobs a single /apply attempts (protects per-company application limits). 0 = no cap.
MAX_APPLIES_PER_RUN=10

# --- Job preferences ---
TARGET_ROLE=Senior Product Manager
# Free-text queries for query-driven sources (comma-separated). Override to retarget
# (e.g. a marketing profile). Defaults to Utku's PM set in config/settings.py.
# SEARCH_QUERIES=Senior Product Manager,Product Manager Fintech,Head of Product
MIN_SALARY=80000
LOCATIONS=EMEA,Remote,US
MAX_JOBS_PER_DAY=80
# How many of the search queries to run per scrape (0 = all).
MAX_QUERIES_PER_RUN=0
# Max roles pulled from a single source per run (above MAX_JOBS_PER_DAY so catalog
# sources keep scanning boards past the day's quota for more breadth).
SOURCE_FETCH_CAP=150
# RemoteOK is tag-driven; these are the tags it fetches (PM title filter trims them).
REMOTEOK_TAGS=product-manager,product
# We Work Remotely category RSS feeds (remote-only).
WEWORKREMOTELY_FEEDS=https://weworkremotely.com/categories/remote-product-jobs.rss

# --- Region / sponsor filtering ---
# Only show jobs marked Remote AND located in one of these regions (us, eu, emea).
REGION_ALLOWLIST=us,eu,emea
# Require remote roles. Set false to also surface on-site.
REMOTE_REQUIRED=true
# Exempt freelance/contract/interim roles from REMOTE_REQUIRED, so the feed reads
# "remote OR freelance". Useful if you'd take an on-site contract gig in your own city
# but not an on-site permanent job. Only the remote gate is exempted — region and
# sponsor checks still apply. See the Profiles section in CLAUDE.md for details.
ALLOW_ONSITE_FREELANCE=false
# Regions where you can actually work without sponsorship/relocation. Remote roles
# locked to countries outside this set (e.g. "Remote - US only", "Remote US/Canada")
# are dropped — they won't take an overseas candidate. Leave empty to disable.
CANDIDATE_WORK_REGIONS=emea,eu
# Companies known to hire international / sponsor visas. Case-insensitive, comma-separated.
SPONSOR_FRIENDLY_COMPANIES=Stripe,GitLab,Automattic,Spotify,Klarna,Wise,Remote,Deel,Toptal,Doist,Buffer,Zapier,Hotjar,Elastic,HashiCorp,Sourcegraph,Vercel,Supabase,Linear,Notion,Figma,Atlassian,Mozilla,Shopify,Discord,Cloudflare,DigitalOcean,n8n,Mattermost,GitHub,MongoDB,Auth0,Postman,Snyk,Datadog,Miro,Loom,1Password,ClickUp
# Companies you never want to see again. Matched on the exact lowercased company string.
SPONSOR_BLOCKLIST_COMPANIES=canonical,openai,open-ai,open ai
# When true, call Claude on jobs whose company is unknown to decide visa-sponsor signal.
ENABLE_LLM_SPONSOR_SCORING=true

# --- Hiring velocity (DB-only signal) ---
VELOCITY_WINDOW_DAYS=14
VELOCITY_HOT_THRESHOLD=3
VELOCITY_BOOST_RANK=true

# --- Scraper health ---
# Comma-separated Playwright selectors tried in order for Wellfound.
WELLFOUND_SELECTORS=div.styles_jobListing__aFBtk,div[class*='jobListing'],div.mb-6
# Skip a scraper when its last N runs all returned 0 jobs (0 = never skip).
SCRAPER_SKIP_AFTER_ZEROS=3
# How long that skip lasts before the source is retried (0 = skip forever, until
# scraper_health is cleared by hand).
SCRAPER_RETRY_AFTER_DAYS=3

# --- Pre-built form answers ---
ANSWER_SALARY=$80,000 - $120,000 depending on total compensation package
ANSWER_AVAILABILITY=Available to start within 2-4 weeks
ANSWER_WORK_AUTH=Based in Turkey, authorized to work in EMEA. Open to relocation and can work US timezone hours.
ANSWER_REMOTE=Yes, I have extensive experience working remotely with distributed teams across Turkey, UAE, KSA, and the US.
ANSWER_YOE=8+
# Sensitive dropdown answers — matched against <select> option text in the
# structured Greenhouse/Lever appliers. yes/no for the visa questions.
ANSWER_REQUIRES_SPONSORSHIP=yes
ANSWER_WORK_AUTHORIZED=no
ANSWER_DEMOGRAPHIC=Decline to self-identify
ANSWER_REFERRAL=LinkedIn

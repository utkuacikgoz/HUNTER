# HUNTER configuration — copy to .env and edit.
#
#     cp .env.example .env
#
# Every value here has a default in config/settings.py; only set a key to
# override one. HUNTER runs entirely locally and holds no secrets: there are no
# API keys, tokens, or credentials of any kind.

# --- Logging ---
LOG_LEVEL=INFO

# --- Job preferences ---
# Free-text queries for query-driven sources (Wellfound), comma-separated.
# SEARCH_QUERIES=Senior Product Manager,Head of Product
# Titles kept from catalog sources (case-insensitive substring match). Widen this
# if the feed runs thin, e.g. add: group product manager,vp of product
# ROLE_MATCH_KEYWORDS=head of product,senior product manager,lead product manager,principal product manager,director of product
LOCATIONS=EMEA,Remote,US
MAX_JOBS_PER_DAY=80
# How many of the search queries to run per scrape (0 = all).
MAX_QUERIES_PER_RUN=0
# Max roles pulled from a single source per run (above MAX_JOBS_PER_DAY so catalog
# sources keep scanning boards past the day's quota for more breadth).
SOURCE_FETCH_CAP=150
# How many ATS boards to fetch at once (1 = serial).
ATS_FETCH_CONCURRENCY=6
# RemoteOK is tag-driven; these are the tags it fetches (title filter trims them).
REMOTEOK_TAGS=product-manager,product,crypto,web3,defi
# We Work Remotely category RSS feeds (remote-only).
WEWORKREMOTELY_FEEDS=https://weworkremotely.com/categories/remote-product-jobs.rss

# --- Region / eligibility filtering ---
# Only surface jobs located in one of these regions (us, eu, emea).
REGION_ALLOWLIST=us,eu,emea
# Require remote roles. Set false to also surface on-site.
REMOTE_REQUIRED=true
# Exempt freelance/contract/interim roles from REMOTE_REQUIRED, so the feed reads
# "remote OR freelance". Useful if you'd take an on-site contract gig in your own
# city but not an on-site permanent job. Only the remote gate is exempted — region
# and lock checks still apply.
ALLOW_ONSITE_FREELANCE=false
# Remote roles locked to a region you can't work from (US/Canada, EU, UK — e.g.
# "Remote - US only", "Remote (EU)", "Remote - Germany") are always dropped; scopes
# that include Turkey (worldwide, EMEA, MENA) are kept. Not configurable via env —
# see scraper/filters.py.
# Companies you never want to see again. Matched on the exact lowercased company string.
SPONSOR_BLOCKLIST_COMPANIES=canonical,openai,open-ai,open ai,dataiku

# --- Hiring velocity (DB-only signal) ---
VELOCITY_WINDOW_DAYS=14
VELOCITY_HOT_THRESHOLD=3
VELOCITY_BOOST_RANK=true

# --- Scraper health ---
# Skip a source after this many consecutive zero-yield runs (0 disables).
SCRAPER_SKIP_AFTER_ZEROS=3
# How long that skip lasts before the source gets another chance (0 = forever).
SCRAPER_RETRY_AFTER_DAYS=3
# Run the browser scraper (Wellfound, launches Chromium). false = API-only, no
# Playwright browser install needed.
ENABLE_BROWSER_SCRAPERS=true

# --- Anti-detection ---
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0
# PROXY_URL=

# --- Database ---
DB_PATH=hunter.db

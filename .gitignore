.env
# Per-profile env overlays (.env.<name>, etc.) hold secrets/PII — never commit.
# The committed *.example templates are the exception.
.env.*
!.env.example
!.env.*.example
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.db
*.log
.coverage
.pytest_cache/
.mypy_cache/
config/resume.pdf
config/resume.txt
# Per-profile resumes (config/resume.<name>.txt, etc.) — PII, never commit.
config/resume.*.txt
config/resume.*.pdf
.playwright/
screenshots/
backups/
node_modules/

# Local resume PDFs (PII) — never commit
resume.pdf

# Keep the build context (and image) small + safe.
.git
.github
.venv
venv
__pycache__
*.pyc
*.pyo

# Local state — must never be baked into the image. Secrets/PII live on the
# /data volume or in `fly secrets`, never in an image layer. Note: .dockerignore
# (unlike .gitignore) is the ONLY thing that keeps `COPY . .` from baking these in.
.env
.env.*
config/resume.txt
config/resume.*.txt
config/resume.pdf
config/resume.*.pdf
*.db
*.db-wal
*.db-shm
*.log
.coverage
.pytest_cache
.mypy_cache
backups/
screenshots/
.playwright/

# Docs / dev-only
*.md
requirements-dev.txt
tests/
